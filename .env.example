# Base URL of the Laravel backend API (https://github.com/makgr/personalportfolio), including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public URL of this frontend, used for SEO metadata (canonical/Open Graph URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seconds API responses stay cached (default 300). Admin edits show up after this,
# or at once when the backend calls POST /api/revalidate.
API_CACHE_SECONDS=300

# Shared secret the backend sends in the x-revalidate-secret header to /api/revalidate
REVALIDATE_SECRET=change-me
